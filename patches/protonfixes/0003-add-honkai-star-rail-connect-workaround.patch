Subject: [PATCH] gamefixes: add Honkai Star Rail connect workaround

---
 gamefixes-umu/umu-honkaistarrail.py | 10 ++++++++++
 1 file changed, 10 insertions(+)
 create mode 100644 gamefixes-umu/umu-honkaistarrail.py

diff --git a/gamefixes-umu/umu-honkaistarrail.py b/gamefixes-umu/umu-honkaistarrail.py
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/gamefixes-umu/umu-honkaistarrail.py
@@ -0,0 +1,10 @@
+"""Game fix for Honkai: Star Rail"""
+
+from protonfixes import util
+
+
+def main() -> None:
+    """Request the narrowly scoped Wine startup connection workaround."""
+    util.set_environment('WINE_HSR_FIRST_CONNECT_REFUSED', '1')
+    util.set_environment('UMU_USE_STEAM', '1')
+    util.set_environment('WINE_DISABLE_VULKAN_OPWR', '1')
