From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Phlogiston contributors <noreply@example.com>
Date: Sat, 12 Sep 2026 00:00:00 +0000
Subject: [PATCH] ws2_32: Gate one-shot HSR connect refusal

Keep the compatibility behavior disabled by default and restrict it to a
validated IPv4 or IPv6 stream socket. Atomically reject exactly one eligible
connect call per process when explicitly requested by the launch profile.
---
 dlls/ws2_32/socket.c | 34 ++++++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/dlls/ws2_32/socket.c b/dlls/ws2_32/socket.c
index f3814a5e7c13..000000000000 100644
--- a/dlls/ws2_32/socket.c
+++ b/dlls/ws2_32/socket.c
@@ -36,6 +36,8 @@ WINE_DECLARE_DEBUG_CHANNEL(winediag);
 
 #define TIMEOUT_INFINITE _I64_MAX
 
+static LONG hsr_connect_refused;
+
 #define u64_from_user_ptr(ptr) ((ULONGLONG)(uintptr_t)(ptr))
 
 static const WSAPROTOCOL_INFOW supported_protocols[] =
@@ -1324,6 +1326,35 @@ int WINAPI closesocket( SOCKET s )
 }
 
 
+static BOOL hsr_refuse_connect( SOCKET s, const struct sockaddr *addr, int len )
+{
+    WSAPROTOCOL_INFOW info;
+    char enabled[2];
+    int size;
+
+    if (addr->sa_family == AF_INET)
+    {
+        if (len < sizeof(struct sockaddr_in)) return FALSE;
+    }
+    else if (addr->sa_family == AF_INET6)
+    {
+        if (len < sizeof(struct sockaddr_in6)) return FALSE;
+    }
+    else return FALSE;
+
+    if (!ws_protocol_info( s, TRUE, &info, &size ) || info.iSocketType != SOCK_STREAM)
+        return FALSE;
+    if (GetEnvironmentVariableA( "WINE_HSR_FIRST_CONNECT_REFUSED", enabled, sizeof(enabled) ) != 1 ||
+        enabled[0] != '1')
+        return FALSE;
+    if (InterlockedCompareExchange( &hsr_connect_refused, 1, 0 )) return FALSE;
+
+    WARN( "refusing the first eligible connect for the HSR compatibility profile\n" );
+    SetLastError( WSAECONNREFUSED );
+    return TRUE;
+}
+
+
 /***********************************************************************
  *      connect   (ws2_32.4)
  */
@@ -1343,6 +1374,9 @@ int WINAPI connect( SOCKET s, const struct sockaddr *addr, int len )
         return -1;
     }
 
+    if (addr && len >= sizeof(addr->sa_family) && hsr_refuse_connect( s, addr, len ))
+        return SOCKET_ERROR;
+
     if (!(sync_event = get_sync_event())) return -1;
 
     if (addr && len > (int)offsetof(struct sockaddr_un, sun_path) && addr->sa_family == AF_UNIX && *addr->sa_data)
-- 
